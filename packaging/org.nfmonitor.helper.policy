<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>nfmonitor</vendor>
  <!-- 只匹配 `pkexec /usr/bin/nfmonitor helper`：只读助手，见 internal/priv。 -->
  <action id="org.nfmonitor.helper">
    <description>Read firewall rules, socket owners and UDP traffic counters</description>
    <description xml:lang="zh_CN">读取防火墙规则、套接字归属与 UDP 流量计数</description>
    <message>nfmonitor needs administrator rights to read firewall rules and per-process UDP traffic (read-only)</message>
    <message xml:lang="zh_CN">nfmonitor 需要管理员权限来读取防火墙规则和各进程的 UDP 流量（只读，不做任何修改）</message>
    <icon_name>nfmonitor</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/nfmonitor</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">helper</annotate>
  </action>
  <!-- 只匹配 `pkexec /usr/bin/nfmonitor ufw-apply`：一次性执行一条 ufw 修改，见 internal/netinfo/ufw.go。 -->
  <action id="org.nfmonitor.ufw">
    <description>Change ufw firewall rules</description>
    <description xml:lang="zh_CN">修改 ufw 防火墙规则</description>
    <message>nfmonitor needs administrator rights to change ufw firewall rules and policies</message>
    <message xml:lang="zh_CN">nfmonitor 需要管理员权限来修改 ufw 防火墙规则与策略</message>
    <icon_name>nfmonitor</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/nfmonitor</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">ufw-apply</annotate>
  </action>
</policyconfig>
